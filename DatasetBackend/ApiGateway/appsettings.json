{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "DatasetApi",
    "Key": "DEV_ONLY_SUPER_LONG_SECRET_KEY_32+CHARS"
  },

  "AllowedCorsOrigins": [ "localhost:5174" ],
  "ReverseProxy": {
    "Routes": {
      "dataset-projects": {
        "ClusterId": "dataset-manager",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "dataset-entities": {
        "ClusterId": "dataset-manager",
        "Match": { "Path": "/api/entities/{**catch-all}" }
      },
      "dataset-attributes": {
        "ClusterId": "dataset-manager",
        "Match": { "Path": "/api/attributes/{**catch-all}" }
      },
      "generator-generate": {
        "ClusterId": "generator-service",
        "Match": { "Path": "/api/generate/{**catch-all}" }
      },
      "generator-export": {
        "ClusterId": "generator-service",
        "Match": { "Path": "/api/export/{**catch-all}" }
      }
    },
    "Clusters": {
      "dataset-manager": {
        "Destinations": {
          "d1": { "Address": "https://localhost:9090/" }
        }
      },
      "generator-service": {
        "Destinations": {
          "d1": { "Address": "https://localhost:9091/" }
        }
      }
    }
  }
}
